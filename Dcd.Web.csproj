<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>dcd-portfolio-local-admin</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;dist/**;wwwroot/assets/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <Watch Include="Frontend/**/*;package.json;package-lock.json;vite.config.mjs" />
  </ItemGroup>
  <Target Name="BuildFrontend" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci" Condition="!Exists('node_modules/vite/package.json')" />
    <Exec Command="npm run build" />
    <ItemGroup>
      <Content Include="wwwroot/assets/**/*" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
