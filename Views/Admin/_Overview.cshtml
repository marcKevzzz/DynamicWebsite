@model AdminPage
@{
    var reports = Model.Section.Key == "reports";
    var latestDay = AdminAnalytics.Days[^1];
    var previousMonth = AdminAnalytics.Days.Last(day => day.Date.Month != latestDay.Date.Month);
    var total = latestDay.Total;
    var inactive = latestDay.Inactive;
    var active = total - inactive;
    var activePercent = active * 100 / total;
    var latest = reports ? total : AdminPreview.Signups[^1].Count;
    var previous = AdminPreview.Signups[^2].Count;
    var signupChange = (latest - previous) * 100 / previous;
    var inactiveChange = inactive - previousMonth.Inactive;
    var activeChange = active - (previousMonth.Total - previousMonth.Inactive);
    var range = $"{AdminAnalytics.FirstDay:MMM d} – {AdminAnalytics.LastDay:MMM d, yyyy}";
    var metrics = new[]
    {
        (Label: "Total users", Value: total, Change: total - previousMonth.Total, Positive: true),
        (Label: "Active users", Value: active, Change: activeChange, Positive: true),
        (Label: "Inactive users", Value: inactive, Change: inactiveChange, Positive: true),
        (Label: reports ? "Sign-ups" : "Monthly sign-ups", Value: latest, Change: signupChange, Positive: false)
    };
    var content = new[]
    {
        (Label: "Projects", Count: Model.Portfolio.Projects.Length, Key: "works"),
        (Label: "Services", Count: Model.Portfolio.Services.Length, Key: "services"),
        (Label: "Team members", Count: Model.Portfolio.Team.Length, Key: "team")
    };
}
<script type="application/json" data-analytics-data>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(AdminAnalytics.Days, System.Text.Json.JsonSerializerOptions.Web))</script>
<span class="sr-only" role="status" data-analytics-announcement></span>
<dl class="admin-metrics" data-analytics-metrics>
    @for (var index = 0; index < metrics.Length; index++)
    {
        var metric = metrics[index];
        var change = metric.Change.ToString("+0;−0;0") + (index == 3 ? "%" : "");
        <div class="admin-metric @(index == 0 ? "admin-metric-featured" : "")">
            <dt data-metric-label>@metric.Label</dt>
            <dd>
                <strong data-metric-value>@metric.Value</strong>
                <span class="admin-metric-comparison">
                    <span class="admin-trend" data-positive="@(!reports && metric.Positive ? "true" : "false")" data-metric-trend>
                        <span data-metric-direction="up" hidden="@(reports || metric.Change <= 0)"><partial name="_AdminIcon" model='"trend-up"' /></span>
                        <span data-metric-direction="down" hidden="@(reports || metric.Change >= 0)"><partial name="_AdminIcon" model='"trend-down"' /></span>
                        <span data-metric-change>@(reports ? "—" : change)</span>
                    </span>
                    <span data-metric-comparison>@(reports ? "No earlier data" : "vs. last month")</span>
                </span>
            </dd>
        </div>
    }
</dl>
<div class="admin-overview">
    <section class="admin-panel admin-chart-panel" aria-labelledby="signups-title">
        <header class="admin-panel-header">
            <h2 id="signups-title">User sign-ups</h2>
            <span class="admin-period"><partial name="_AdminIcon" model='"calendar"' /> <span data-analytics-range>@range</span></span>
        </header>
        <div class="admin-chart">
            <div class="admin-chart-scale mono" aria-hidden="true"><span>40</span><span>32</span><span>24</span><span>16</span><span>8</span><span>0</span></div>
            <ul class="admin-bars" role="list" aria-label="Sign-ups by period" style="--plot-columns: @AdminPreview.Signups.Count">
                @for (var monthIndex = 0; monthIndex < AdminPreview.Signups.Count; monthIndex++)
                {
                    var period = AdminPreview.Signups[monthIndex];
                    var dateLabel = AdminAnalytics.FirstDay.AddMonths(monthIndex).ToString("MMMM yyyy");
                    <li class="admin-bar" data-current="@(monthIndex == AdminPreview.Signups.Count - 1 ? "true" : "false")" style="--bar-count: @period.Count">
                        <button type="button" class="admin-chart-point" aria-pressed="false" aria-label="@dateLabel, @period.Count sign-ups">
                            <span class="admin-bar-plot">
                                <span class="admin-bar-fill"><strong data-point-value>@period.Count</strong></span>
                            </span>
                            <span class="admin-bar-label mono" data-point-label>@period.Label</span>
                            <span class="admin-chart-tooltip" aria-hidden="true"><span data-point-date>@dateLabel</span><strong data-point-count>@period.Count sign-ups</strong></span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </section>
    @if (reports)
    {
        <section class="admin-panel admin-status-chart" aria-labelledby="account-status-title">
            <header class="admin-panel-header"><h2 id="account-status-title">Account status</h2></header>
            <div class="admin-ring" style="--active-share: @activePercent; --segment-gap: @(inactive > 0 && active > 0 ? 2 : 0)" data-analytics-ring>
                <svg viewBox="0 0 144 144" role="group" aria-label="Account status chart">
                    <defs>
                        <mask id="ring-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="144" height="144">
                            <circle class="admin-ring-reveal" cx="72" cy="72" r="53" pathLength="100" stroke="white" stroke-width="56" fill="none" />
                        </mask>
                        <filter id="ring-corners" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
                            <feGaussianBlur stdDeviation="1.5" />
                            <feComponentTransfer><feFuncA type="linear" slope="8" intercept="-3.5" /></feComponentTransfer>
                        </filter>
                    </defs>
                    <g mask="url(#ring-reveal)" filter="url(#ring-corners)">
                        <circle class="admin-ring-active" cx="72" cy="72" r="53" pathLength="100" tabindex="0"
                                role="img" aria-label="@active active accounts" data-ring-segment="active" />
                        <circle class="admin-ring-inactive" cx="72" cy="72" r="53" pathLength="100" tabindex="0"
                                role="img" aria-label="@inactive inactive accounts" data-ring-segment="inactive" />
                    </g>
                </svg>
                <div class="admin-ring-center" aria-hidden="true"><strong data-ring-value>@activePercent%</strong><span data-ring-label>Active</span></div>
            </div>
            <dl class="admin-breakdown">
                <div><dt>Active</dt><dd data-analytics-active>@active</dd></div>
                <div><dt>Inactive</dt><dd data-analytics-inactive>@inactive</dd></div>
            </dl>
        </section>
    }
    else
    {
        <section class="admin-panel admin-activity-panel" aria-labelledby="recent-activity-title">
            <header class="admin-panel-header">
                <h2 id="recent-activity-title">Recent activity</h2>
                <a class="admin-stat-arrow" asp-controller="Admin" asp-action="Index" asp-route-sectionKey="activity" aria-label="View all activity"><partial name="_AdminIcon" model='"arrow-up-right"' /></a>
            </header>
            <partial name="_Activity" model="AdminPreview.Events.OrderByDescending(item => item.OccurredAt).Take(10)" />
        </section>
    }
</div>
<div class="@(reports ? null : "admin-overview")">
        <ul class="admin-content-stats" role="list" aria-label="Content counts">
            @foreach (var item in content)
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index" asp-route-sectionKey="@item.Key">
                        <span>@item.Label</span>
                        <span class="admin-stat-arrow"><partial name="_AdminIcon" model='"arrow-up-right"' /></span>
                        <strong data-content-count>@item.Count</strong>
                    </a>
                </li>
            }
        </ul>
    @if (!reports)
    {
        <section class="admin-panel admin-preview-status" aria-labelledby="preview-status-title">
            <h2 id="preview-status-title">Preview status</h2>
            <span class="admin-status" data-active="true">Available</span>
        </section>
    }
</div>
