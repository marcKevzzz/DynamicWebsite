@model bool
@{
    var latestDay = AdminAnalytics.Days[^1];
    var previousMonth = AdminAnalytics.Days.Last(day => day.Date.Month != latestDay.Date.Month);
    var total = latestDay.Total;
    var inactive = latestDay.Inactive;
    var active = total - inactive;
    var activePercent = active * 100 / total;
    var latest = Model ? total : AdminPreview.Signups[^1].Count;
    var previous = AdminPreview.Signups[^2].Count;
    var signupChange = (latest - previous) * 100 / previous;
    var inactiveChange = inactive - previousMonth.Inactive;
    var activeChange = active - (previousMonth.Total - previousMonth.Inactive);
    var range = $"{AdminAnalytics.FirstDay:MMM d} – {AdminAnalytics.LastDay:MMM d, yyyy}";
    var metrics = new[]
    {
        (Label: "Total users", Value: total, Change: total - previousMonth.Total, Positive: true),
        (Label: "Active users", Value: active, Change: activeChange, Positive: true),
        (Label: "Inactive users", Value: inactive, Change: inactiveChange, Positive: true),
        (Label: Model ? "Sign-ups" : "Monthly sign-ups", Value: latest, Change: signupChange, Positive: false)
    };
}
<script type="application/json" data-analytics-data>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(AdminAnalytics.Days, System.Text.Json.JsonSerializerOptions.Web))</script>
<span class="sr-only" role="status" data-analytics-announcement></span>
<dl class="admin-metrics" data-analytics-metrics>
    @for (var index = 0; index < metrics.Length; index++)
    {
        var metric = metrics[index];
        var change = metric.Change.ToString("+0;−0;0") + (index == 3 ? "%" : "");
        <div class="admin-metric @(index == 0 ? "admin-metric-featured" : "")">
            <dt data-metric-label>@metric.Label</dt>
            <dd>
                <strong data-metric-value>@metric.Value</strong>
                <span class="admin-metric-comparison">
                    <span class="admin-trend" data-positive="@(!Model && metric.Positive ? "true" : "false")" data-metric-trend>
                        <span data-metric-direction="up" hidden="@(Model || metric.Change <= 0)"><partial name="_AdminIcon" model='"trend-up"' /></span>
                        <span data-metric-direction="down" hidden="@(Model || metric.Change >= 0)"><partial name="_AdminIcon" model='"trend-down"' /></span>
                        <span data-metric-change>@(Model ? "—" : change)</span>
                    </span>
                    <span data-metric-comparison>@(Model ? "No earlier data" : "vs. last month")</span>
                </span>
            </dd>
        </div>
    }
</dl>
<div class="admin-overview">
    <section class="admin-panel admin-chart-panel" aria-labelledby="signups-title">
        <header class="admin-panel-header">
            <h2 id="signups-title">User sign-ups</h2>
            <span class="admin-period"><partial name="_AdminIcon" model='"calendar"' /> <span data-analytics-range>@range</span></span>
        </header>
        <div class="admin-chart">
            <div class="admin-chart-scale mono" aria-hidden="true"><span>32</span><span>24</span><span>16</span><span>8</span><span>0</span></div>
            <ul class="admin-bars" role="list" aria-label="Sign-ups by period" style="--plot-columns: @AdminPreview.Signups.Count">
                @for (var monthIndex = 0; monthIndex < AdminPreview.Signups.Count; monthIndex++)
                {
                    var period = AdminPreview.Signups[monthIndex];
                    var dateLabel = AdminAnalytics.FirstDay.AddMonths(monthIndex).ToString("MMMM yyyy");
                    <li class="admin-bar" data-current="@(monthIndex == AdminPreview.Signups.Count - 1 ? "true" : "false")" style="--bar-count: @period.Count">
                        <button type="button" class="admin-chart-point" aria-pressed="false" aria-label="@dateLabel, @period.Count sign-ups">
                            <span class="admin-bar-plot">
                                <span class="admin-bar-fill"><strong data-point-value>@period.Count</strong></span>
                            </span>
                            <span class="admin-bar-label mono" data-point-label>@period.Label</span>
                            <span class="admin-chart-tooltip" aria-hidden="true"><span data-point-date>@dateLabel</span><strong data-point-count>@period.Count sign-ups</strong></span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </section>
    @if (Model)
    {
        <section class="admin-panel" aria-labelledby="account-status-title">
            <header class="admin-panel-header"><h2 id="account-status-title">Account status</h2></header>
            <div class="admin-ring" style="--active-share: @activePercent%" aria-label="@activePercent percent active" role="img" data-analytics-ring><span>@activePercent%</span></div>
            <dl class="admin-breakdown">
                <div><dt>Active</dt><dd data-analytics-active>@active</dd></div>
                <div><dt>Inactive</dt><dd data-analytics-inactive>@inactive</dd></div>
            </dl>
        </section>
    }
    else
    {
        <section class="admin-panel admin-activity-panel" aria-labelledby="recent-activity-title">
            <header class="admin-panel-header"><h2 id="recent-activity-title">Recent activity</h2></header>
            <partial name="_Activity" model="AdminPreview.Events.Take(4)" />
            <a class="admin-inline-link" asp-controller="Admin" asp-action="Index" asp-route-sectionKey="activity">Activity <partial name="_Arrow" /></a>
        </section>
    }
</div>
@if (!Model)
{
    <section class="admin-panel admin-content-panel" aria-labelledby="admin-content-title">
        <header class="admin-panel-header"><h2 id="admin-content-title">Website content</h2></header>
        <ul class="admin-content-links" role="list">
            @foreach (var item in AdminPreview.Sections.Where(item => item.Group == "Website"))
            {
                <li><a asp-controller="Admin" asp-action="Index" asp-route-sectionKey="@item.Key"><partial name="_AdminIcon" model="item.Key" /><span>@item.Title</span><partial name="_Arrow" /></a></li>
            }
        </ul>
    </section>
}
