@model AdminPage
@{
    Layout = "_AdminLayout";
}
@switch (Model.Section.Key)
{
    case "dashboard":
    case "reports":
        <partial name="_Overview" model="Model" />
        break;
    case "home":
    case "about":
    case "contacts":
        var fields = Model.Portfolio.SettingsFields(Model.Section.Key);
        <form asp-controller="AdminContent" asp-action="Save" asp-route-sectionKey="@Model.Section.Key" asp-route-recordKey="settings"
              method="post" enctype="multipart/form-data" id="admin-page-form" class="admin-panel admin-single-panel" aria-label="@Model.Section.Title settings" data-admin-form>
            <div asp-validation-summary="All" role="alert"></div>
            <input type="hidden" name="Revision" value="@Model.Portfolio.Revisions[(Model.Section.Key, "settings")]" />
            <partial name="_Fields" model="new AdminForm(fields, true, Model.Section.Key)" />
        </form>
        break;
    case "works":
    case "services":
    case "team":
    case "users":
        <partial name="_ContentList" model="AdminRecords.Get(Model.Section.Key, Model.Portfolio, Model.Users)" />
        break;
    case "activity":
        <partial name="_ActivityTimeline" />
        break;
}
