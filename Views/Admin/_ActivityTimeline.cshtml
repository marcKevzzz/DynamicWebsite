@model AdminPage
@{
    var groups = Model.Events.GroupBy(entry => DateOnly.FromDateTime(entry.OccurredAt));
}
<div class="admin-panel admin-activity-list" data-activity-list>
    @foreach (var group in groups)
    {
        var dateKey = group.Key.ToString("yyyy-MM-dd");
        <section class="admin-timeline-group" data-activity-date="@dateKey" aria-labelledby="activity-@dateKey">
            <h2 id="activity-@dateKey" class="admin-timeline-date"><time datetime="@dateKey">@group.Key.ToString("dddd, MMMM d, yyyy")</time></h2>
            <ul role="list">
                @foreach (var entry in group)
                {
                    <li>
                        <a class="admin-timeline-row" asp-action="Record" asp-route-sectionKey="activity" asp-route-recordKey="@entry.Id">
                            <time class="admin-timeline-time" datetime="@entry.OccurredAt.ToString("s")">@entry.OccurredAt.ToString("h:mm tt")</time>
                            <span class="admin-timeline-event">
                                <span class="admin-row-icon"><partial name="_AdminIcon" model="entry.Icon" /></span>
                                <span class="admin-row-copy"><strong>@entry.Action</strong><span>@entry.Subject</span></span>
                            </span>
                            <span class="admin-timeline-actor">@entry.Actor</span>
                            <span class="admin-timeline-arrow"><partial name="_AdminIcon" model='"arrow-right"' /></span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
    <p class="admin-timeline-empty" data-activity-empty hidden="@(Model.Events.Length > 0)">No activity in this date range.</p>
</div>
