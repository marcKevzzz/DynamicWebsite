@model AdminPage
@{
    Layout = "_AdminLayout";
    var record = Model.Record!;
    var key = Context.Request.RouteValues["recordKey"]?.ToString() ?? "new";
    var revision = Model.Portfolio.Revisions.GetValueOrDefault((Model.Section.Key, key));
    var editable = record.SaveLabel is not null;
}

@section PageActions {
    @if (editable)
    {
        <div class="admin-record-actions">
            @if (record.IsOwner is { } isOwner)
            {
                <form asp-controller="AdminContent" asp-action="Owner" asp-route-sectionKey="team" asp-route-recordKey="@key" method="post" data-confirm-content="Set this team member as owner?">
                    <input type="hidden" name="Revision" value="@revision" />
                    <button class="button" type="submit" data-admin-owner disabled="@isOwner">@(isOwner ? "Owner" : "Set as owner")</button>
                </form>
            }
            @if (key != "new" && record.IsOwner != true)
            {
                <form asp-controller="AdminContent" asp-action="Delete" asp-route-sectionKey="@Model.Section.Key" asp-route-recordKey="@key" method="post" data-confirm-content="Remove this record from the portfolio?">
                    <input type="hidden" name="Revision" value="@revision" />
                    <button class="button" type="submit">Remove</button>
                </form>
            }
            <button class="button button-primary" type="submit" form="admin-page-form">
                @record.SaveLabel <partial name="_AdminIcon" model='"arrow-up-right"' />
            </button>
        </div>
    }
}

@if (editable)
{
    <form asp-controller="AdminContent" asp-action="Save" asp-route-sectionKey="@Model.Section.Key" asp-route-recordKey="@key"
          method="post" enctype="multipart/form-data" id="admin-page-form" class="admin-panel admin-single-panel" aria-label="@record.Title" data-admin-form>
        <div asp-validation-summary="All" role="alert"></div>
        <input type="hidden" name="Revision" value="@revision" />
        <partial name="_Fields" model="new AdminForm(record.Fields, true, Model.Section.Key)" />
    </form>
}
else if (record.User is { } user)
{
    <section class="admin-panel admin-single-panel admin-detail-summary" aria-label="User details">
        <span class="admin-row-icon admin-initials" aria-hidden="true">@user.Initials</span>
        <div class="admin-detail-identity">
            <div class="admin-detail-name">
                <h2>@user.Name</h2>
                <span class="admin-status" data-active="@(user.Active ? "true" : "false")">@(user.Active ? "Active" : "Inactive")</span>
            </div>
            <a href="mailto:@user.Email">@user.Email</a>
        </div>
        <dl class="admin-detail-meta">
            <div><dt>Joined</dt><dd><time datetime="@user.Joined.ToString("yyyy-MM-dd")">@user.Joined.ToString("MMM d, yyyy")</time></dd></div>
            <div><dt>Last sign-in (UTC)</dt><dd>@(user.LastSignIn?.ToString("MMM d, yyyy · h:mm tt") ?? "Never")</dd></div>
        </dl>
    </section>
}
else if (record.Activity is { } activity)
{
    <section class="admin-panel admin-single-panel admin-detail-summary" aria-label="Activity details">
        <span class="admin-row-icon"><partial name="_AdminIcon" model="activity.Icon" /></span>
        <div class="admin-detail-identity">
            <h2>@activity.Subject</h2>
            <p>By @activity.Actor</p>
        </div>
        <dl class="admin-detail-meta">
            <div><dt>Occurred</dt><dd><time datetime="@activity.OccurredAt.ToString("s")">@activity.OccurredAt.ToString("MMM d, yyyy · h:mm tt")</time></dd></div>
        </dl>
    </section>
}
