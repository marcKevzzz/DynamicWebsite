@model NavLink[]
<header class="header">
    <div class="header-bar">
        <a href="#home" class="brand" aria-label="dcd. home">dcd<span class="accent">.</span></a>
        <div class="header-controls">
            <a class="circle-button" asp-controller="Account" asp-action="SignIn" aria-label="Sign in" title="Sign in" data-cursor="sign in">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
            </a>
            <button class="circle-button" type="button" data-theme aria-label="Switch to light theme" hidden>
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
                    <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" />
                    <path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
                </svg>
            </button>
            <button class="circle-button mobile-nav-toggle" type="button" data-mobile-nav
                    aria-controls="header-navigation" aria-expanded="false" aria-label="Open navigation" hidden>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                </svg>
            </button>
            <div class="header-action">
                <a href="#work" class="button button-small header-cta">Explore the work <partial name="_Arrow" /></a>
            </div>
        </div>
        <nav id="header-navigation" aria-label="Main navigation" data-lenis-prevent>
            @foreach (var link in Model)
            {
                <a href="#@link.Id" class="nav-link" aria-label="@link.Label">
                    <span class="nav-label"><span class="nav-label-inner" data-label="@link.Label">@link.Label</span></span>
                    <svg class="mobile-nav-arrow" aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"
                         fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12l8-8M5 4h7v7" />
                    </svg>
                </a>
            }
            <a href="#work" class="button button-small mobile-nav-cta">Explore the work <partial name="_Arrow" /></a>
        </nav>
    </div>
    <div class="nav-ruler" aria-hidden="true">
        <div class="ruler-track"></div><div class="ruler-progress"></div>
        <span class="ruler-marker mono">00%</span>
    </div>
</header>
