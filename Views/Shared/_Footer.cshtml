@model NavLink[]
@{
    const string email = "dcd.inc.mail@gmail.com";
    const string github = "https://github.com/dcd-inc";
    const string facebook = "https://www.facebook.com/profile.php?id=61595626853093";
    const string instagram = "https://www.instagram.com/dcdstudio.dev/";
    var emailLink = "mailto:" + email;
    var introLink = emailLink + "?subject=Intro%20call";
}
<footer class="site-footer section-shell" id="contact" aria-labelledby="contact-title">
    <div class="footer-top">
        <div class="footer-intro">
            <p class="mono accent">Contact</p>
            <h2 id="contact-title">Let’s build<br />something.</h2>
            <a class="button button-primary" href="@emailLink">Email the studio <partial name="_Arrow" /></a>
        </div>
        <nav class="footer-col" aria-label="Footer navigation">
            <p class="mono">Navigate</p>
            <ul>
                <li><a href="#home">Home <span aria-hidden="true">↗</span></a></li>
                @foreach (var link in Model.Where(link => link.Id != "contact"))
                {
                    <li><a href="#@link.Id">@link.Label <span aria-hidden="true">↗</span></a></li>
                }
            </ul>
        </nav>
        <div class="footer-col">
            <p class="mono">Get in touch</p>
            <ul>
                <li><a href="@emailLink">@email <span aria-hidden="true">↗</span></a></li>
                <li><a href="@introLink">Ask for an intro call <span aria-hidden="true">↗</span></a></li>
                <li><a href="@github" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
            </ul>
            <div class="footer-socials">
                <a class="circle-button" href="@github" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.61-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1.01.07 1.54 1.04 1.54 1.04.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .26.18.57.69.47A10 10 0 0 0 12 2Z"/></svg>
                </a>
                <a class="circle-button" href="@facebook" target="_blank" rel="noopener noreferrer"
                   aria-label="Facebook">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07Z"/></svg>
                </a>
                <a class="circle-button" href="@instagram" target="_blank" rel="noopener noreferrer"
                   aria-label="Instagram">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.85" fill="currentColor" stroke="none"/></svg>
                </a>
                <a class="circle-button" href="@emailLink" aria-label="Email the studio">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                </a>
            </div>
        </div>
    </div>
    <svg class="footer-mark" viewBox="0 0 1000 175" preserveAspectRatio="none" aria-hidden="true">
        <text x="2" y="174" textLength="996" lengthAdjust="spacingAndGlyphs">We Decide<tspan>.</tspan></text>
    </svg>
</footer>
