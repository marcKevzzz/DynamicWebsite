@model AdminPage
@inject Microsoft.AspNetCore.Identity.UserManager<Dcd.Web.Data.ApplicationUser> Accounts
@{
    var pageTitle = Model.Record?.Title ?? Model.Section.Title;
    var account = await Accounts.GetUserAsync(User);
}
<!doctype html>
<html lang="en" data-page="admin">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1b1b" />
    <meta name="robots" content="noindex" />
    <title>@pageTitle · dcd. Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/assets/site.css" asp-append-version="true" />
    <script src="~/js/appearance.js" asp-append-version="true"></script>
    <script type="module" src="~/assets/admin.js" asp-append-version="true"></script>
</head>
<body class="admin-body" data-signed-in="@(TempData["AdminSignedIn"] as bool? == true ? "true" : null)">
    <a class="skip-link" href="#admin-main">Skip to content</a>
    <div class="admin-shell">
        <aside id="admin-sidebar" class="admin-sidebar" aria-label="Sidebar">
            <div class="admin-sidebar-header">
                <a asp-controller="Admin" asp-action="Index" asp-route-sectionKey="dashboard" class="brand" aria-label="dcd. admin dashboard">dcd<span class="accent">.</span></a>
                <button type="button" class="admin-sidebar-toggle" data-admin-collapse aria-controls="admin-navigation" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar" hidden>
                    <partial name="_AdminIcon" model='"sidebar"' />
                </button>
                <button type="button" class="admin-sidebar-toggle" aria-label="Close navigation" data-admin-close hidden>
                    <partial name="_AdminIcon" model='"close"' />
                </button>
            </div>
            <nav id="admin-navigation" class="admin-nav" aria-label="Admin">
                @foreach (var group in AdminPreview.Sections.GroupBy(item => item.Group))
                {
                    <p class="admin-nav-group mono">@group.Key</p>
                    <ul role="list" aria-label="@group.Key">
                        @foreach (var item in group)
                        {
                            <li>
                                <a asp-controller="Admin" asp-action="Index" asp-route-sectionKey="@item.Key"
                                   aria-current="@(item == Model.Section ? "page" : null)" aria-label="@item.Title" title="@item.Title">
                                    <partial name="_AdminIcon" model="item.Key" />
                                    <span class="admin-nav-label">@item.Title</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </nav>
            <div class="admin-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" data-admin-logout>
                    <button type="submit" aria-label="Log out" title="Log out">
                    <partial name="_AdminIcon" model='"logout"' /><span class="admin-nav-label">Log out</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="admin-backdrop" data-admin-backdrop aria-hidden="true"></div>
        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="admin-topbar-group">
                    <button type="button" class="admin-sidebar-toggle" data-admin-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="Open navigation" hidden>
                        <partial name="_AdminIcon" model='"sidebar"' />
                    </button>
                    <button type="button" class="admin-search-trigger" data-admin-search aria-label="Search admin pages" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" hidden>
                        <partial name="_AdminIcon" model='"search"' /><span>Search</span><kbd class="mono">Ctrl K</kbd>
                    </button>
                </div>
                <div class="admin-topbar-group">
                    <button type="button" class="circle-button admin-icon-button admin-theme-button" data-admin-theme aria-label="Switch theme" hidden>
                        <partial name="_ThemeIcons" />
                    </button>
                    <a class="circle-button admin-icon-button" asp-controller="Account" asp-action="Profile" aria-label="My profile" data-admin-open="admin-profile"><partial name="_AdminIcon" model='"users"' /></a>
                    <a class="button admin-site-link" asp-controller="Home" asp-action="Index">Visit site <partial name="_Arrow" /></a>
                </div>
            </header>
            <main id="admin-main" class="admin-main" data-section="@Model.Section.Key">
                <header class="admin-page-heading">
                    <div class="admin-page-title" data-record="@(Model.Record is not null ? "true" : null)">
                        @if (Model.Record is not null)
                        {
                            <a class="circle-button admin-icon-button admin-back-button" asp-controller="Admin" asp-action="Index" asp-route-sectionKey="@Model.Section.Key" aria-label="Back to @Model.Section.Title" title="Back to @Model.Section.Title">
                                <partial name="_AdminIcon" model='"arrow-left"' />
                            </a>
                        }
                        <h1>@pageTitle</h1>
                    </div>
                    @if (IsSectionDefined("PageActions"))
                    {
                        @await RenderSectionAsync("PageActions")
                    }
                    else
                    {
                        @switch (Model.Section.Key)
                        {
                            case "dashboard":
                            case "reports":
                                <partial name="_AnalyticsFilters" model="Model" />
                                break;
                            case "activity" when Model.Events.Length > 0:
                                var firstDate = DateOnly.FromDateTime(Model.Events.Min(item => item.OccurredAt));
                                var lastDate = DateOnly.FromDateTime(Model.Events.Max(item => item.OccurredAt));
                                <partial name="_AdminDatePicker" model='new AdminDatePicker("activity-dates", "All dates", firstDate, lastDate, firstDate, lastDate)' />
                                break;
                            case "home":
                            case "about":
                            case "contacts":
                                <button class="button button-primary" type="submit" form="admin-page-form">Save changes <partial name="_AdminIcon" model='"arrow-up-right"' /></button>
                                break;
                            case "works":
                            case "services":
                            case "team":
                                var entity = Model.Section.Key switch { "works" => "project", "services" => "service", _ => "team member" };
                                <a class="button button-primary" asp-action="Record" asp-route-sectionKey="@Model.Section.Key" asp-route-recordKey="new">
                                    <partial name="_AdminIcon" model='"plus"' /> Add @entity
                                </a>
                                break;
                        }
                    }
                </header>
                @if (TempData["ContentMessage"] is string message)
                {
                    <p role="status">@message</p>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_AdminSearch" />
    <dialog id="admin-profile" class="shortcut-dialog admin-record-dialog" aria-labelledby="admin-profile-title">
        <header class="admin-panel-header">
            <h2 id="admin-profile-title">Admin profile</h2>
            <button type="button" class="circle-button admin-icon-button" data-admin-dismiss aria-label="Close"><partial name="_AdminIcon" model='"close"' /></button>
        </header>
        <form asp-controller="Account" asp-action="Profile" method="post">
            <div class="admin-fields">
                <div class="admin-field">
                    <label class="admin-field-label" for="admin-first-name">First name</label>
                    <input class="admin-input" id="admin-first-name" name="FirstName" value="@account?.FirstName" autocomplete="given-name" maxlength="100" required autofocus />
                </div>
                <div class="admin-field">
                    <label class="admin-field-label" for="admin-last-name">Last name</label>
                    <input class="admin-input" id="admin-last-name" name="LastName" value="@account?.LastName" autocomplete="family-name" maxlength="100" required />
                </div>
                <div class="admin-field"><span class="admin-field-label">Email</span><span>@account?.Email</span></div>
            </div>
            <p role="status" aria-live="polite" data-profile-status></p>
            <div class="admin-dialog-actions"><button class="button button-primary" type="submit">Save profile <partial name="_Arrow" /></button></div>
        </form>
    </dialog>
    <dialog class="shortcut-dialog admin-image-lightbox" aria-label="Image preview" data-admin-lightbox>
        <button type="button" class="circle-button admin-icon-button" data-admin-dismiss aria-label="Close image preview" autofocus>
            <partial name="_AdminIcon" model='"close"' />
        </button>
        <img alt="" />
    </dialog>
    <partial name="_ConfirmDialog" />
</body>
</html>
