<dialog id="admin-confirm" class="shortcut-dialog admin-record-dialog" aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-description">
    <header class="admin-panel-header">
        <h2 id="admin-confirm-title"></h2>
        <button class="circle-button admin-icon-button" type="button" data-confirm-dismiss aria-label="Close"><partial name="_AdminIcon" model='"close"' /></button>
    </header>
    <p class="admin-dialog-description" id="admin-confirm-description"></p>
    <form method="dialog" class="admin-dialog-actions">
        <button type="submit" class="button" value="cancel" autofocus>Cancel</button>
        <button type="submit" class="button button-primary" value="confirm"></button>
    </form>
</dialog>
