@model AdminForm
@{
    var formId = $"admin-fields-{Guid.NewGuid():N}";
}
<div class="admin-fields" data-layout="@Model.Layout">
    @for (var index = 0; index < Model.Fields.Length; index++)
    {
        var field = Model.Fields[index];
        if (ViewData["Draft"] is ContentEdit draft && field.Type != "image")
            field = field with { Value = draft.Value(field.Label) };
        var id = $"{formId}-{index}";
        var messageId = $"{id}-message";
        var required = Model.Editable && field.Required;
        var icon = field.Icon ?? (field.Type switch { "url" => "globe", "email" => "contacts", _ => null });
        <div class="admin-field" data-wide="@(field.Wide || field.Multiline || field.Type == "image" ? "true" : "false")">
            <label class="admin-field-label" for="@(field.Type != "image" || Model.Editable ? id : null)">
                @field.Label
                @if (required)
                {
                    <span aria-hidden="true">*</span>
                }
            </label>
            @if (field.Type == "image")
            {
                <div class="admin-image-field" data-image-style="@field.ImageStyle">
                    <ul class="admin-image-list" role="list" aria-label="@field.Label" data-admin-images>
                        @foreach (var image in field.Images ?? [])
                        {
                            var source = image.StartsWith("~/") ? image : image.StartsWith('/') ? $"~{image}" : $"~/images/{image}";
                            var name = System.IO.Path.GetFileName(image);
                            <li class="admin-image-tile" data-image-path="@image">
                                @if (Model.Editable)
                                {
                                    <label data-native-retain><input type="checkbox" name="Images" value="@image" checked /> Keep @name</label>
                                }
                                <button type="button" class="admin-image-open" data-admin-image-open aria-label="Preview @name">
                                    <img src="@Url.Content(source)" alt="" draggable="false" />
                                </button>
                                <span class="admin-image-name" title="@name">@name</span>
                                @if (Model.Editable && field.ImageStyle != "logo")
                                {
                                    <button class="admin-image-remove circle-button" type="button" aria-label="Remove @name" data-admin-remove-image>
                                        <partial name="_AdminIcon" model='"close"' />
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                    @if (Model.Editable)
                    {
                        <input id="@id" class="admin-image-input sr-only" type="file" name="Uploads" multiple="@field.Multiple"
                               accept=".png,.jpg,.jpeg,.webp,.gif"
                               aria-required="@required.ToString().ToLowerInvariant()" aria-describedby="@messageId"
                               data-admin-input data-label="@field.Label" />
                        @if (field.ImageStyle == "stack")
                        {
                            <label class="admin-image-picker admin-stack-prompt" for="@id">Add image</label>
                        }
                        else if (field.ImageStyle == "logo")
                        {
                            <div class="admin-logo-actions">
                                <label class="admin-image-picker button" for="@id"><span data-logo-replace>Change image</span><span data-logo-add>Add image</span></label>
                                <button class="button" type="button" data-admin-remove-logo>Remove</button>
                            </div>
                        }
                        else
                        {
                            <label class="admin-image-picker button" for="@id" aria-hidden="true">
                                <partial name="_AdminIcon" model='"plus"' />
                                @(field.Multiple ? "Add images" : "Choose image")
                            </label>
                        }
                    }
                </div>
            }
            else if (field.Multiline)
            {
                <textarea name="Fields[@field.Label]" id="@id" class="admin-input" data-admin-input data-label="@field.Label"
                          readonly="@(!Model.Editable)" required="@required" rows="@(Model.Layout == "home" ? 3 : 4)"
                          aria-describedby="@(Model.Editable ? messageId : null)">@field.Value</textarea>
            }
            else if (field.Type == "chips")
            {
                <input class="admin-input" name="Fields[@field.Label]" value="@field.Value" id="@id" data-chips-value />
                <div class="admin-chips" hidden>
                    @foreach (var chip in field.Value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="admin-chip"><span>@chip</span><button type="button" data-remove-chip aria-label="Remove @chip">×</button></span>
                    }
                    <input aria-label="@field.Label" type="text" data-chip-input placeholder="Add @field.Label.ToLowerInvariant()" autocomplete="off" />
                </div>
            }
            else
            {
                <div class="admin-input-control">
                    @if (icon is not null)
                    {
                        <span class="admin-input-icon"><partial name="_AdminIcon" model="icon" /></span>
                    }
                    <input name="Fields[@field.Label]" id="@id" class="admin-input" type="@field.Type" data-admin-input data-label="@field.Label"
                           readonly="@(!Model.Editable)" required="@required" value="@field.Value"
                           placeholder="@(field.Type == "email" ? "you@example.com" : field.Type == "url" ? "https://example.com" : null)"
                           aria-describedby="@(Model.Editable ? messageId : null)" />
                </div>
            }
            @if (Model.Editable)
            {
                <p id="@messageId" class="admin-field-message" aria-live="polite"></p>
            }
        </div>
    }
</div>
