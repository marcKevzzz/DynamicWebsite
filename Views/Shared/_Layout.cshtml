@model PortfolioPage
@{
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/";
    var shareImage = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/images/dcd-share.png")}";
    var description = Model.Company.Description;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1b1b" />
    <meta name="description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Model.Company.Name" />
    <meta property="og:title" content="@Model.Company.Name" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@siteUrl" />
    <meta property="og:image" content="@shareImage" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dcd. logo on a dark background" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Company.Name" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@shareImage" />
    <meta name="twitter:image:alt" content="dcd. logo on a dark background" />
    <title>@Model.Company.Name</title>
    @if (Model.Company.Logo is { } logo)
    {
        <link rel="icon" href="@Url.Content(logo.StartsWith('/') ? "~" + logo : "~/images/" + logo)" />
    }
    <link rel="stylesheet" href="~/assets/site.css" asp-append-version="true" />
    <script src="~/js/appearance.js" asp-append-version="true"></script>
    <script type="module" src="~/assets/site.js" asp-append-version="true"></script>
</head>
<body>
    <div id="home" class="portfolio">
        <div class="opening-cover" aria-hidden="true"></div>
        <div class="cursor" aria-hidden="true">
            <div class="cursor__crosshair"><span class="cursor__h"></span><span class="cursor__v"></span></div>
            <div class="cursor__pt"><span class="cursor__ring"></span><span class="cursor__label mono"></span></div>
        </div>
        <a class="skip-link" href="#main">Skip to content</a>
        <partial name="_Header" model="Model.Navigation" />
        <main id="main">@RenderBody()</main>
        <partial name="_Footer" model="Model" />
        <partial name="_Shortcuts" model="Model.Navigation" />
    </div>
    <partial name="_ConfirmDialog" />
</body>
</html>
