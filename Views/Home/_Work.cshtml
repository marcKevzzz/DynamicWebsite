@model Project[]
<section id="work" class="work section-shell" aria-labelledby="work-title">
    <div class="work-index">
        <h2 id="work-title" class="mono">Works</h2>
        <p class="work-count"><span class="work-current" aria-hidden="true">01</span><span class="outline-text" aria-hidden="true">/@Model.Length.ToString("D2")</span><span class="sr-only">@Model.Length projects</span></p>
    </div>
    <ol class="work-gallery" role="list">
        @for (var i = 0; i < Model.Length; i++)
        {
            var project = Model[i];
            <li class="work-item" data-project="@project.Id" style="--work-row: @(i + 1)">
                <a class="work-card" href="@project.Url" data-cursor="view project ↗" aria-label="@project.Name">
                    <span class="work-frame" aria-hidden="true">
                        <span class="work-preview"><partial name="_ProjectArt" model="project" /></span>
                    </span>
                    <span class="work-card-label">
                        <span class="mono">@((i + 1).ToString("D2"))</span>
                        <span class="work-name">@project.Name</span>
                        <span class="work-arrow" aria-hidden="true">↗</span>
                    </span>
                </a>
            </li>
        }
    </ol>
    <div class="team-profiles" hidden>
        @foreach (var project in Model)
        {
            <article class="team-card" data-project="@project.Id">
                <div class="team-chapter team-profile project-profile">
                    <h3 class="team-profile-name project-title" style="--title-size: @project.TitleSize">@project.Name</h3>
                    <figure class="team-portrait project-art">
                        <partial name="_ProjectArt" model="project" />
                        @if (project.Image is null)
                        {
                            <figcaption class="mono">Interface mockup</figcaption>
                        }
                    </figure>
                    <div class="team-profile-copy">
                        <p class="team-profile-role">@project.Category</p>
                        <button type="button" class="team-chapter-link mono" data-team-chapter="1" aria-label="Tools of the trade">
                            <span class="team-scroll-hint">Scroll for more</span><partial name="_Arrow" />
                        </button>
                        <div class="project-description">
                            @foreach (var paragraph in project.Details)
                            {
                                <p>@paragraph</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="team-chapter team-tools project-tools">
                    <h4>Tools of the trade</h4>
                    <div class="project-tools-bottom">
                        <ul role="list">
                            @for (var i = 0; i < project.Stack.Length; i++)
                            {
                                <li><span class="mono" aria-hidden="true">@((i + 1).ToString("D2"))</span><span class="team-tool-name">@project.Stack[i]</span></li>
                            }
                        </ul>
                        <div class="project-actions">
                            @if (project.Github is not null)
                            {
                                <a class="button button-small" href="@project.Github" target="_blank" rel="noopener noreferrer">View GitHub <partial name="_Arrow" /></a>
                            }
                            @if (project.Url != project.Github)
                            {
                                <a class="button button-small" href="@project.Url" target="_blank" rel="noopener noreferrer">Visit project <partial name="_Arrow" /></a>
                            }
                            <button type="button" class="team-chapter-link mono" data-team-chapter="2" aria-label="Other projects">Other projects <partial name="_Arrow" /></button>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
    <dialog class="team-dialog project-dialog" aria-labelledby="project-dialog-title" data-lenis-prevent>
        <span id="project-dialog-title" class="sr-only"></span>
        <button type="button" class="team-close" data-team-close aria-label="Close project" data-cursor="close" autofocus><span aria-hidden="true">×</span></button>
        <div class="team-scroll" data-lenis-prevent>
            <div class="team-scroll-path"><div class="team-track"></div></div>
        </div>
        <div class="team-chapter team-others project-others">
            <h4>Other projects</h4>
            <div class="team-others-list project-other-list">
                @for (var i = 0; i < Model.Length; i++)
                {
                    var project = Model[i];
                    <a href="@project.Url" class="team-other project-other" aria-label="@project.Name" data-cursor="view project ↗">
                        <span class="mono">@((i + 1).ToString("D2"))</span><span>@project.Name</span><span aria-hidden="true">↗</span>
                    </a>
                }
            </div>
        </div>
    </dialog>
</section>
