@model TeamMember[]
<section id="team" class="team section-shell" aria-labelledby="team-title">
    <h2 id="team-title" class="team-title">Meet the team</h2>
    <ul class="team-roster" role="list">
        @foreach (var member in Model)
        {
            var split = (member.Name.Length + 1) / 2;
            <li>
                <a class="team-person" href="#@member.Id" aria-label="@member.Name" data-cursor="meet @member.Name ↗">
                    <span aria-hidden="true">@member.Name[..split]</span>
                    @if (member.Thumbnail is { } image)
                    {
                        <img src="@Url.Content("~/images/" + image)" alt="" loading="lazy" decoding="async" />
                    }
                    <span aria-hidden="true">@member.Name[split..]</span>
                </a>
            </li>
        }
    </ul>
    <div class="team-profiles">
        @foreach (var member in Model)
        {
            <article id="@member.Id" class="team-card">
                <div class="team-chapter team-profile">
                    <h3 class="team-profile-name" style="--name-length: @(member.Name == "Chrstpr" ? 6 : member.Name.Length)">
                        <span class="team-profile-alias">@member.Name</span>
                        @if (member.FullName is not null)
                        {
                            <span class="team-profile-fullname">@member.FullName</span>
                        }
                    </h3>
                    <figure class="team-portrait">
                        @if (member.Portrait is { } image)
                        {
                            <img src="@Url.Content("~/images/" + image)" alt="" loading="lazy" decoding="async" />
                        }
                    </figure>
                    <div class="team-profile-copy">
                        <div class="team-profile-identity">
                            @if (member.IsOwner)
                            {
                                <p class="team-owner-label mono">Owner</p>
                            }
                            <p class="team-profile-role">@member.Role</p>
                        </div>
                        <button type="button" class="team-chapter-link mono" data-team-chapter="1"
                                aria-label="Tools of the trade" data-cursor="tools →">
                            <span class="team-scroll-hint">Scroll for more</span><partial name="_Arrow" />
                        </button>
                        <p class="member-bio">@member.Bio</p>
                    </div>
                </div>
                <div class="team-chapter team-tools">
                    <div>
                        <h4>Tools of the trade</h4>
                        <ul role="list">
                            @for (var i = 0; i < member.Stack.Length; i++)
                            {
                                <li><span class="mono" aria-hidden="true">@((i + 1).ToString("D2"))</span><span class="team-tool-name">@member.Stack[i]</span></li>
                            }
                        </ul>
                        <div class="team-actions">
                            @if (member.Github is not null)
                            {
                                <a href="@member.Github" target="_blank" rel="noopener noreferrer" class="button button-small">
                                    <span>View GitHub</span><partial name="_Arrow" />
                                </a>
                            }
                            @if (member.Email is not null)
                            {
                                <a href="mailto:@member.Email" class="button button-small">Email me <partial name="_Arrow" /></a>
                            }
                            <button type="button" class="team-chapter-link mono" data-team-chapter="2"
                                aria-label="Other team members" data-cursor="teammates →">Other team members <partial name="_Arrow" /></button>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
    <dialog class="team-dialog" aria-labelledby="team-dialog-title">
        <h2 id="team-dialog-title" class="sr-only"></h2>
        <button type="button" class="team-close" data-team-close aria-label="Close profile"
                data-cursor="close" autofocus><span aria-hidden="true">×</span></button>
        <div class="team-scroll" data-lenis-prevent>
            <div class="team-scroll-path">
                <div class="team-track"></div>
            </div>
        </div>
        <div class="team-chapter team-others">
            <h4>Other team<br />members</h4>
            <div class="team-others-list">
                @foreach (var member in Model)
                {
                    <a href="#@member.Id" class="team-other" aria-label="@member.Name" data-cursor="meet @member.Name ↗">
                        @if (member.Thumbnail is { } image)
                        {
                            <img src="@Url.Content("~/images/" + image)" alt="" loading="lazy" decoding="async" />
                        }
                        <span aria-hidden="true">@member.Name</span>
                    </a>
                }
            </div>
        </div>
    </dialog>
</section>
