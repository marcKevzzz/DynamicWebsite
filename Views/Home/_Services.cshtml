@model Service[]
<section id="services" class="services-section section-shell" aria-label="Services">
    <div class="section-top mono">
        <span>[ 03 ] SERVICES</span>
        <a href="#contact" class="services-top-link">GET IN TOUCH →</a>
    </div>
    <ol class="services-list">
        @foreach (var service in Model)
        {
            <li class="service-row">
                <a href="#contact" class="service__link" data-cursor="@service.Cursor">
                    <span class="service__n mono" aria-hidden="true">@service.Number</span>
                    <h2 class="service__title">@service.Title</h2>
                    <div class="service__content">
                        <p class="service__body">@service.Body</p>
                        <ul class="service__tags">
                            @foreach (var tag in service.Tags)
                            {
                                <li class="service__tag" tabindex="0">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="@(tag.Trim().ToLowerInvariant() switch
                                        {
                                            "next.js" => "M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0ZM8 16V8l8 11M16 8v6",
                                            "gsap" => "m13 2-8 12h6l-1 8 9-12h-6l1-8Z",
                                            "react" => "M4 12a8 3 0 1 0 16 0 8 3 0 1 0-16 0Zm4 7 8-14M8 5l8 14",
                                            "typescript" => "M4 7h8M8 7v10m6-1c2 2 6 1 6-1 0-3-6-1-6-5 0-2 4-3 6-1",
                                            "codex" => "M4 6h16v12H4zM7 9l3 3-3 3m6 0h4",
                                            "custom agents" => "M6 8h12a2 2 0 0 1 2 2v7H4v-7a2 2 0 0 1 2-2Zm6 0V4m-4 8h.01m8 0h.01",
                                            "tooling" => "M4 8h16v11H4zM9 8V5h6v3M4 12h16m-10 0v2h4v-2",
                                            "workflows" => "M4 4h6v6H4zm10 10h6v6h-6zM7 10v7h7",
                                            "rag" => "M5 4h9l4 4v6M5 4v16h6m-3-9h6m-6 4h4m2 3 2 2 4-5",
                                            "semantic search" => "M15 15l5 5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Zm-10 0h6m-3-3v6",
                                            "postgresql" => "M4 6c0-4 16-4 16 0s-16 4-16 0Zm0 0v12c0 4 16 4 16 0V6M4 12c0 4 16 4 16 0",
                                            "real-time sync" => "M4 10a8 8 0 0 1 14-4l2 2m0-4v4h-4m4 6a8 8 0 0 1-14 4l-2-2m0 4v-4h4",
                                            _ => "M3 4h8l10 10-7 7L3 10zM7 7h.01"
                                        })" />
                                    </svg>
                                    <span class="service__tooltip mono">@tag</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <span class="service__arrow" aria-hidden="true">→</span>
                </a>
            </li>
        }
    </ol>
</section>
