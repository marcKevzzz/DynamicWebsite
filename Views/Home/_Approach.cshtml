@model CompanyContent
<section class="manifesto section-shell" id="about" aria-labelledby="about-title">
    <h2 id="about-title" class="about-label mono">About</h2>
    <div class="manifesto-stage">
        @foreach (var line in Model.Headline.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            <p class="wf-line">
                <span class="outline-text" aria-hidden="true">@line</span>
                <span class="wf-solid">@line</span>
            </p>
        }
    </div>
    <div class="about-note">
        <a href="#home" class="about-mark" aria-label="@Model.Name home">
            @if (Model.Logo == "/favicon.svg")
            {
                <text>dcd<span class="accent">.</span></text>
            }
            else if (Model.Logo is { } logo)
            {
                <img src="@Url.Content("~/images/" + logo)" width="64" height="64" alt="@Model.Name" />
            }
            else
            {
                @Model.Name
            }
        </a>
        <p><span>@Model.Description</span></p>
    </div>
</section>
