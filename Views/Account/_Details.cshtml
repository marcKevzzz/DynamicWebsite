@model AccountNameViewModel
    <div class="account-name-fields">
        <div class="account-field">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" autocomplete="given-name" required maxlength="100" aria-describedby="FirstName-error" placeholder="First name" />
            <span asp-validation-for="FirstName" id="FirstName-error" class="account-field-message" aria-live="polite"></span>
        </div>
        <div class="account-field">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" autocomplete="family-name" required maxlength="100" aria-describedby="LastName-error" placeholder="Last name" />
            <span asp-validation-for="LastName" id="LastName-error" class="account-field-message" aria-live="polite"></span>
        </div>
    </div>
