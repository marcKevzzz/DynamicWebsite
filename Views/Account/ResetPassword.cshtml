@model ResetPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Reset password";
    ViewData["CloseToSignIn"] = true;
}
<h1 id="account-title" class="account-title account-title-single">Reset password.</h1>
<form asp-action="ResetPassword" method="post" class="account-form" data-account-form>
    <div asp-validation-summary="All" class="account-status" role="alert"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="Token" type="hidden" />
    <div class="account-field">
        <label asp-for="Password"></label>
        <div class="account-password">
            <input asp-for="Password" autocomplete="new-password" required minlength="8" maxlength="128" aria-describedby="Password-error" placeholder="At least 8 characters" />
            <button type="button" class="account-password-toggle" data-password-toggle aria-controls="Password" aria-label="Show password" aria-pressed="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="account-eye-slash" d="m4 4 16 16"/></svg>
            </button>
        </div>
        <span asp-validation-for="Password" id="Password-error" class="account-field-message" aria-live="polite"></span>
    </div>
    <div class="account-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="account-password">
            <input asp-for="ConfirmPassword" autocomplete="new-password" required maxlength="128" aria-describedby="ConfirmPassword-error" placeholder="Repeat your password" />
            <button type="button" class="account-password-toggle" data-password-toggle aria-controls="ConfirmPassword" aria-label="Show confirm password" aria-pressed="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="account-eye-slash" d="m4 4 16 16"/></svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="account-field-message" aria-live="polite"></span>
    </div>
    <button type="submit" class="button account-submit">Reset password <partial name="_Arrow" /></button>
</form>
<div class="account-links"><a asp-action="ForgotPassword">Request another link</a></div>
