@model ForgotPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Forgot password";
    ViewData["CloseToSignIn"] = true;
}
<h1 id="account-title" class="account-title account-title-single">Forgot password?</h1>
<p class="account-description">Start with your email address to recover access to your account.</p>
<form asp-action="ForgotPassword" method="post" class="account-form" data-account-form>
    <div asp-validation-summary="ModelOnly" class="account-status" role="alert"></div>
    <div class="account-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="Email-error" placeholder="you@example.com" />
        <span asp-validation-for="Email" id="Email-error" class="account-field-message" aria-live="polite"></span>
    </div>
    <button type="submit" class="button account-submit">Continue <partial name="_Arrow" /></button>
</form>
<div class="account-links">
    <p>Remember your password? <a asp-action="SignIn">Sign in</a></p>
</div>
